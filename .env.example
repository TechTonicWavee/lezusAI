# DRISHTI AI — Environment Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit your actual .env file or real secrets to Git.

# Server & Network Binding
DRISHTI_HOST=0.0.0.0
DRISHTI_PORT=8001
PORT=8001
DRISHTI_LOG_LEVEL=info
DRISHTI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# Administrative Master Key (Required for project registration, model promotion, and training)
# Generate a strong random key: python -c "import secrets; print('dr_master_' + secrets.token_hex(24))"
DRISHTI_MASTER_API_KEY=dr_master_replace_with_strong_random_token_in_production

# Operator Key (Optional: for incident triage and resolution without full administrator rights)
DRISHTI_OPERATOR_API_KEY=

# Prometheus Metrics Scraping
# Set to 'true' to allow standard open Prometheus scrape probes, or configure a scraper token
DRISHTI_ALLOW_ANONYMOUS_METRICS=true
DRISHTI_METRICS_KEY=

# MLOps MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_NAME=taxi_fare_predictor
RETRAIN_RMSE_THRESHOLD=0.05

# Keep Integration Adapter (Optional external AIOps server)
KEEP_API_URL=http://localhost:8080
KEEP_API_KEY=
