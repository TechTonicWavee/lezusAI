# DRISHTI AI — Configuration Template
# Copy to .env and adjust as necessary for local development

# Server Configuration
DRISHTI_HOST=127.0.0.1
DRISHTI_PORT=8000
DRISHTI_LOG_LEVEL=info

# Security & API Key Overrides
DRISHTI_MASTER_API_KEY=dr_live_master_override_key_replace_in_production

# MLOps MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_NAME=taxi_fare_predictor
RETRAIN_RMSE_THRESHOLD=0.05

# Keep Integration Adapter (Optional external AIOps server)
KEEP_API_URL=http://localhost:8080
KEEP_API_KEY=

